{
  "name": "secretaria-ia-whatsapp",
  "version": "1.0.0",
  "description": "Secretária de IA para clínicas no WhatsApp (API oficial da Meta ou WAHA), com Claude, painel ao vivo, laboratório de testes, agenda e aprendizado revisado pela equipe.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-concurrency=1",
    "lab": "node --env-file-if-exists=.env scripts/run-lab.js",
    "lab:comparar": "node --env-file-if-exists=.env scripts/run-lab.js --comparar",
    "demo": "node --env-file-if-exists=.env scripts/seed-demo.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0"
  },
  "keywords": [
    "whatsapp",
    "claude",
    "secretaria",
    "clinica",
    "agendamento",
    "ia"
  ]
}
