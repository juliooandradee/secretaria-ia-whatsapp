# Copie este arquivo para .env e preencha. Nunca suba o .env para o GitHub.

# ── Painel ──────────────────────────────────────────────
PORT=3000
# Senha do painel (usuário: equipe). Use uma senha longa.
PANEL_PASSWORD=troque-esta-senha-por-uma-bem-longa
# Endereço público do servidor (usado nos webhooks). Ex.: https://minha-secretaria.up.railway.app
PUBLIC_URL=http://localhost:3000
TIMEZONE=America/Sao_Paulo
DATA_DIR=./data

# ── IA (Claude) ─────────────────────────────────────────
# Crie em https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo inicial (depois você troca pelo painel, em Ajustes).
# Comece pelo melhor e só depois teste os mais baratos no laboratório.
# claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
AI_MODEL=claude-opus-5-5
# Esforço de raciocínio: low | medium | high
AI_EFFORT=medium
# Quantas respostas da IA por dia, no máximo (inclui o laboratório).
AI_DAILY_LIMIT=300

# ── Canal do WhatsApp ───────────────────────────────────
# simulado (para testar sem WhatsApp) | oficial (API da Meta) | waha (API não oficial)
WHATSAPP_CHANNEL=simulado

# API oficial (Meta Cloud API) — veja docs/api-oficial.md
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
# Modelos (templates) aprovados na Meta para mensagens fora da janela de 24 horas
META_TEMPLATE_CONFIRMATION=confirmacao_consulta
META_TEMPLATE_FOLLOWUP=retorno_paciente
META_TEMPLATE_LANGUAGE=pt_BR

# API não oficial (WAHA) — veja docs/waha.md
WAHA_URL=http://localhost:3008
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=
# Opcional: endereço que o WAHA usa para avisar este servidor (padrão: PUBLIC_URL/webhooks/waha)
WAHA_WEBHOOK_URL=
# Opcional (Docker Compose): no Mac com chip Apple, se precisar, devlikeapro/waha:arm
WAHA_IMAGE=devlikeapro/waha:latest

# ── Ritmo das respostas ─────────────────────────────────
# Espera o paciente terminar de escrever antes de responder (segundos de silêncio).
INBOUND_WAIT_SECONDS=20
# Tempo de "digitando..." proporcional ao tamanho da resposta.
TYPING_MS_PER_CHAR=40
TYPING_MAX_SECONDS=12

# ── Automações (ligue no painel quando estiver pronto) ──
CONFIRMATION_HOURS_BEFORE=24
FOLLOWUP_DAYS_AFTER=7
# Não envia mensagens automáticas entre estas horas (início-fim).
QUIET_HOURS=20-8
